// ============================================================================
//  ARRANQUE — carga de Three.js (jsDelivr vía importmap, con respaldo en esm.sh)
// ============================================================================
async function loadThree() {
  const ADD = ['geometries/RoundedBoxGeometry.js', 'postprocessing/EffectComposer.js', 'postprocessing/RenderPass.js', 'postprocessing/UnrealBloomPass.js', 'postprocessing/OutputPass.js', 'lights/RectAreaLightUniformsLib.js'];
  const pack = (T3, m) => ({ T: T3, RoundedBoxGeometry: m[0].RoundedBoxGeometry, EffectComposer: m[1].EffectComposer, RenderPass: m[2].RenderPass, UnrealBloomPass: m[3].UnrealBloomPass, OutputPass: m[4].OutputPass, RectAreaLightUniformsLib: m[5].RectAreaLightUniformsLib });
  const timeout = (p, ms) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error('tiempo de espera agotado')), ms))]);
  try { const T3 = await timeout(import('three'), 25000); const m = await timeout(Promise.all(ADD.map(a => import('three/addons/' + a))), 25000); return pack(T3, m); }
  catch (e) { console.warn('jsDelivr no disponible:', e && e.message); }
  try { const base = 'https://esm.sh/three@0.170.0'; const T3 = await timeout(import(base), 25000); const m = await timeout(Promise.all(ADD.map(a => import(base + '/examples/jsm/' + a))), 25000); return pack(T3, m); }
  catch (e) { console.warn('esm.sh no disponible:', e && e.message); }
  return null;
}

(async function boot() {
  UI.init();
  const q = new URLSearchParams(location.search);
  let ok = false;
  if (!q.has('2d')) {
    $('#load-msg').textContent = 'Cargando el motor 3D (Three.js)…';
    const lib = await loadThree();
    if (lib) { try { $('#load-msg').textContent = 'Construyendo la sala…'; await World.init(lib); ok = true; } catch (e) { console.error('No se pudo iniciar el 3D:', e); World.enabled = false; } }
  }
  if (!ok) {
    Map2D.init();
    const n = el(`<div class="notice">${q.has('2d') ? 'Modo plano 2D.' : 'No se pudo iniciar el motor 3D (sin conexión al CDN de Three.js o WebGL no disponible). Se usa el plano 2D: la investigación es completa igualmente.'}</div>`);
    $('#app').appendChild(n); setTimeout(() => n.remove(), 14000);
  }
  $('#screen-loading').classList.add('hidden');
  UI.title();
  let last = performance.now();
  const loop = now => { const dt = Math.min(0.1, Math.max(0, (now - last) / 1000)); last = now; try { G.tick(dt); World.frame(dt); } catch (e) { console.error(e); } requestAnimationFrame(loop); };
  requestAnimationFrame(loop);
  if (q.has('debug')) window.__CO = { get S() { return S; }, G, Game, Nav, World, OBJ, UI, Term, CODE, SND };
})();

