        World.update('grc');
      };
      on(b, '.token', 'click', (e, x) => { e.stopPropagation(); if (S.f.r3) return; sel = sel === x.dataset.r ? null : x.dataset.r; SND.play('ui'); draw(); });
      on(b, '.cell', 'click', (e, c) => { if (S.f.r3 || !sel) return; st.pos[sel] = [+c.dataset.p, +c.dataset.i]; SND.play('beep', 3); draw(); G.saveSoon(); });
      $('#val', b).onclick = () => {
        if (S.f.r3) return;
