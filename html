        cam.position.copy(this.base.p).addScaledVector(right, this.par.x * 0.03).addScaledVector(up, this.par.y * 0.018); cam.quaternion.copy(this.base.q);
      }
    }
    if (this.shake > 0) { cam.position.x += (Math.random() - 0.5) * this.shake * 0.035; cam.position.y += (Math.random() - 0.5) * this.shake * 0.025; this.shake = Math.max(0, this.shake - dt * 1.4); }
    if (this.hoverTest && !this.moving && this.ok() && this.frameN % 2 === 0) { this.hoverTest = false; this.setHover(this.pick()); }
    this.dynamic(dt);
