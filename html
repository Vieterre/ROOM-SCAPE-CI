function finalScore() {
  const min = S.elapsed / 60;
  let sc = 100 - 4 * S.stats.hints - Math.min(30, 2 * S.stats.errors);
  if (!S.f.r9) sc -= 15;
  if (min <= 60) sc += 5; if (min > 95) sc -= 5;
  if (S.findings.includes('F12')) sc += 2; if (S.findings.includes('F13')) sc += 2;
  sc = clamp(Math.round(sc), 0, 100);
  const lvl = sc >= 90 ? 'Optimizado' : sc >= 75 ? 'Gestionado' : sc >= 60 ? 'Definido' : sc >= 45 ? 'Repetible' : 'Inicial';
  return { sc, lvl };
}

