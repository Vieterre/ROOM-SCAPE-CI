#map2d{position:absolute;inset:0;z-index:5;display:grid;grid-template-columns:1fr 360px;background:radial-gradient(ellipse at 40% 40%,#1a2027,#07090c)}
.mapwrap{display:flex;align-items:center;justify-content:center;padding:90px 30px 110px}
.mapwrap svg{width:100%;height:100%;max-height:78vh}
.mapzone{cursor:pointer;transition:all .15s}
.mapzone:hover rect,.mapzone.on rect{fill:#3b2f14;stroke:#f2c46d}
.mappanel{background:#0e1217;border-left:1px solid var(--line2);padding:90px 18px 110px;overflow:auto}
.mappanel h4{font-family:var(--serif);letter-spacing:2px;text-transform:uppercase;font-size:14px;margin:0 0 12px;color:#f1e7d2;font-weight:normal}
.mapobj{display:block;width:100%;text-align:left;padding:10px 12px;margin:0 0 8px;border-radius:10px;border:1px solid var(--line2);background:#161b22;cursor:pointer;font-size:13.5px;color:#e6e1d6}
.mapobj:hover{border-color:var(--brass)}
.mapobj small{display:block;color:var(--muted);font-size:11.5px;margin-top:2px}
.notice{position:absolute;left:50%;top:70px;transform:translateX(-50%);z-index:20;background:#2a1d06;border:1px solid #7a5413;color:#ffd08a;padding:8px 14px;border-radius:10px;font-size:12.5px;max-width:80vw;text-align:center}

