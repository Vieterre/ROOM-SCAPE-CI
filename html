  // Si el equipo no sostiene ~28 fps, se baja la calidad automáticamente (salvo elección manual del jugador)
  perf(dt) {
    if (!S.started || SETTINGS.manualQ || this.perfDone) return;
    this.pf = this.pf || { t: 0, n: 0, wait: 2 };
    if (this.pf.wait > 0) { this.pf.wait -= dt; return; }
    this.pf.t += dt; this.pf.n++;
    if (this.pf.t >= 3) {
