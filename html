        const fl = S.findings.filter(f => /^C\d$/.test(FINDINGS[f].ctl));
        $('#fl', b).innerHTML = fl.length ? fl.map(f => `<span class="tag red" style="margin:2px">${f} → ${FINDINGS[f].ctl}</span>`).join(' ') : 'Ninguna deficiencia de control documentada todavía.';
