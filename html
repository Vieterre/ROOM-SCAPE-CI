const MAP_ZONES = {
  door: [-135, -302, 270, 30], access: [-262, -302, 64, 22], safe: [194, -288, 82, 66], keycab: [-350, -246, 16, 52],
  board: [-350, -148, 16, 186], grc: [-350, 100, 16, 100], shelf: [300, -216, 46, 212], filing: [288, 180, 62, 50],
  desk: [-56, 220, 172, 78], shredder: [-152, 256, 40, 32], coat: [-312, 238, 34, 34],
};
const Map2D = {
  active: false, st: 'overview',
  init() {
    this.active = true; const m = $('#map2d'); m.classList.remove('hidden');
    m.innerHTML = `<div class="mapwrap"><svg viewBox="-380 -340 760 680" id="msvg"></svg></div><div class="mappanel" id="mpanel"></div>`;
    on(m, '.mapzone', 'click', (e, z) => { SND.play('ui'); Nav.go(z.dataset.s); });
    on(m, '.mapobj', 'click', (e, b) => { SND.play('ui'); if (b.dataset.s) Nav.go(b.dataset.s); else if (b.dataset.o) { Game.interact(b.dataset.o); this.refresh(); } });
    this.refresh();
  },
  go(st) { if (!this.active) return; this.st = st; this.refresh(); },
