function openShredder() {
  const st = S.p.tiras; const N = 8;
  if (!st.order) st.order = [5, 2, 7, 0, 3, 6, 1, 4];
  if (st.lockEdges && !S.f.r7) { const o = st.order; [0, N - 1].forEach(t => { const cur = o.indexOf(t); [o[t], o[cur]] = [o[cur], o[t]]; }); }
  const src = drawCertificate(document.createElement('canvas'));
  const sw = src.width / N; let sel = null;
  UI.open({
    title: 'Trituradora · papelera de tiras', sub: 'Corte en tiras verticales', sound: 'shred', html: `<div class="tool" style="width:min(980px,96vw)">
      <h3>Reconstrucción documental</h3><div class="sub">La papelera de la trituradora tiene las tiras de un solo documento: alguien lo destruyó hace poco y la máquina se atascó. Haz clic en dos tiras para intercambiarlas hasta reconstruir la hoja.</div>
      <div class="strips" id="sp"></div><div class="feedback info"></div></div>`,
    mount(b) {
      const H = Math.min(560, window.innerHeight * 0.58), sc = H / src.height;
      const draw = () => {
        const sp = $('#sp', b); sp.innerHTML = ''; sp.classList.toggle('done', !!S.f.r7);
        st.order.forEach((t, pos) => {
          const c = document.createElement('canvas'); c.width = Math.round(sw * sc); c.height = Math.round(H);
          const x = c.getContext('2d'); x.drawImage(src, t * sw, 0, sw, src.height, 0, 0, c.width, c.height);
          if (!S.f.r7) { x.strokeStyle = 'rgba(0,0,0,.25)'; x.beginPath(); x.moveTo(0.5, 0); x.lineTo(0.5, c.height); x.moveTo(c.width - .5, 0); x.lineTo(c.width - .5, c.height); x.stroke(); }
          c.className = 'strip' + (sel === pos ? ' sel' : '') + (st.lockEdges && (t === 0 || t === N - 1) && pos === t ? ' locked' : '');
          c.dataset.pos = pos; c.style.transform = S.f.r7 ? 'none' : `rotate(${((t * 37) % 5 - 2) * 0.35}deg)`;
          sp.appendChild(c);
        });
      };
      on(b, '.strip', 'click', (e, c) => {
        if (S.f.r7 || c.classList.contains('locked')) return;
        const pos = +c.dataset.pos;
        if (sel === null) { sel = pos; SND.play('paper'); }
        else if (sel === pos) sel = null;
        else { const o = st.order; [o[sel], o[pos]] = [o[pos], o[sel]]; sel = null; SND.play('paper'); G.saveSoon(); }
        draw();
        if (st.order.every((t, i) => t === i)) {
          G.solve('r7'); draw(); addFact('Certificado de NÉBULA: matriculada el 02-jul-2026 con capital de $1.000.000; representante legal y accionista única: Elena Ruiz Ortega; domicilio Cra. 14 # 82-31, Of. 302.');
          G.seeDoc('cert_camara');
          fb(b, 'Documento reconstruido: <b>certificado de existencia de Servicios Integrales NÉBULA S.A.S.</b> Matriculada el 02-jul-2026, seis días antes de darse de alta como proveedor; capital de $1.000.000; representante legal y accionista única: <b>Elena Ruiz Ortega</b>. Domicilio: Carrera 14 # 82-31, Of. 302.', 'ok');
        }
      });
      draw(); if (S.f.r7) fb(b, 'Documento reconstruido. Lo tienes también en el Expediente.', 'ok');
    },
  });
}

