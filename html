    this.hands.h.rotation.z = -((secs / 3600) % 12) / 12 * Math.PI * 2; this.hands.m.rotation.z = -((secs / 60) % 60) / 60 * Math.PI * 2; this.hands.s.rotation.z = -(Math.floor(secs) % 60) / 60 * Math.PI * 2;
    const pa = this.dust.geometry.attributes.position, b = this.dustBase;
    for (let i = 0; i < pa.count; i++) { const k = i * 3; pa.array[k] = b[k] + Math.sin(t * 0.07 + i) * 0.09; pa.array[k + 1] = b[k + 1] + Math.sin(t * 0.045 + i * 1.7) * 0.12; pa.array[k + 2] = b[k + 2] + Math.cos(t * 0.06 + i * 0.6) * 0.09; }
    pa.needsUpdate = true;
    const ring = this.ringUntil && t < this.ringUntil, vmNew = f.vm && !f.vmHeard;
    this.phoneLED.material.color.setHex(ring ? ((t * 6) % 1 < 0.5 ? 0xff2a2a : 0x220404) : vmNew ? ((t * 1.4) % 1 < 0.5 ? 0xff2a2a : 0x220404) : 0x220404);
    this.camLED.material.color.setHex((t % 1.6) < 0.12 ? 0xff2a2a : 0x2a0505);
    this.smokeLED.material.color.setHex((t % 3) < 0.1 ? 0x33ff77 : 0x062010);
    this.badgeLED.material.color.setHex(f.door ? 0x33ff77 : 0xff2a2a);
    const fl = this.flickerUntil && t < this.flickerUntil;
    this.panels.forEach((p, i) => { const on = !(fl && i === 0) || Math.sin(t * 37) * Math.sin(t * 13.7) > 0.2; p.L.intensity = on ? p.base : 0.4; p.d.material.color.setHex(on ? 0xf2f6ff : 0x2a2c30); });
    if (this.frameN % 30 === 0) this.padTex.draw();
  },
};

// ============================================================================
//  INSPECTOR 3D DE OBJETOS DEL INVENTARIO (arrastrar para girar)
// ============================================================================
const Inspector = {
  r: null, scene: null, cam: null, models: {}, active: null, rx: 0.35, ry: 0, auto: true,
  ensure() {
    if (this.r || !World.enabled) return !!this.r;
    const c = document.createElement('canvas'); c.width = 520; c.height = 340; c.style.cssText = 'width:100%;height:100%;display:block;cursor:grab';
    this.canvas = c;
    this.r = new T.WebGLRenderer({ canvas: c, antialias: true, alpha: false });
    this.r.setPixelRatio(Math.min(devicePixelRatio || 1, 2)); this.r.setSize(520, 340, false);
    this.r.outputColorSpace = T.SRGBColorSpace; this.r.toneMapping = T.ACESFilmicToneMapping; this.r.toneMappingExposure = 1.1;
    const s = this.scene = new T.Scene(); s.background = new T.Color(0x0d1015);
    if (World.envTex) { s.environment = World.envTex; s.environmentIntensity = 1.4; }
    s.add(new T.HemisphereLight(0xdfe8f2, 0x2a2620, 1.6));
    const k = new T.SpotLight(0xfff2dc, 6, 0, 0.8, 0.6, 2); k.position.set(0.25, 0.35, 0.4); s.add(k, k.target);
    const rim = new T.PointLight(0x8fb8ff, 1.2, 0, 2); rim.position.set(-0.3, 0.1, -0.25); s.add(rim);
    const floor = new T.Mesh(new T.CircleGeometry(0.22, 48), new T.MeshStandardMaterial({ color: 0x1a1e24, roughness: 0.6, metalness: 0.3 })); floor.rotation.x = -Math.PI / 2; floor.position.y = -0.055; s.add(floor);
    this.cam = new T.PerspectiveCamera(32, 520 / 340, 0.01, 10); this.cam.position.set(0, 0.06, 0.27); this.cam.lookAt(0, -0.004, 0);
    let drag = null;
    c.addEventListener('pointerdown', e => { drag = { x: e.clientX, y: e.clientY, rx: this.rx, ry: this.ry }; this.auto = false; c.style.cursor = 'grabbing'; try { c.setPointerCapture(e.pointerId); } catch (er) {} });
    c.addEventListener('pointermove', e => { if (!drag) return; this.ry = drag.ry + (e.clientX - drag.x) * 0.012; this.rx = clamp(drag.rx + (e.clientY - drag.y) * 0.01, -1.3, 1.3); });
    c.addEventListener('pointerup', () => { drag = null; c.style.cursor = 'grab'; });
    return true;
  },
  model(id) {
    if (this.models[id]) return this.models[id];
    const g = new T.Group(); const S2 = (geo, mat, x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0) => { const m = new T.Mesh(geo, mat); m.position.set(x, y, z); m.rotation.set(rx, ry, rz); g.add(m); return m; };
    const brass = new T.MeshStandardMaterial({ color: 0xcaa45a, roughness: 0.25, metalness: 1, envMap: World.envTex || null, envMapIntensity: 2 });
    const tagTex = (txt, col) => TX.label(256, 128, col, [{ t: txt, f: 'bold 64px Arial', y: 66, c: col === '#f2c94c' || col === '#8a96a3' ? '#111' : '#fff' }]);
    if (id.startsWith('k_')) {
      const tag = { k_gl: ['GL-1', '#8a96a3'], k_arch: ['ARCH-01', '#f2c94c'], k_cf1: ['CF-1', '#e5484d'], k_cf2: ['CF-2', '#3b82f6'] }[id];
      S2(new T.TorusGeometry(0.022, 0.006, 16, 40), brass, -0.05, 0, 0);
      S2(new T.BoxGeometry(0.075, 0.012, 0.004), brass, 0.012, 0, 0);
      [0.03, 0.042, 0.052].forEach((x, i) => S2(new T.BoxGeometry(0.006, 0.01 + i * 0.004, 0.004), brass, x, -0.01 - i * 0.002, 0));
      S2(new T.TorusGeometry(0.012, 0.0018, 8, 24), new T.MeshStandardMaterial({ color: 0xb9bec4, metalness: 1, roughness: 0.3 }), -0.075, 0, 0, Math.PI / 2);
      S2(new T.BoxGeometry(0.05, 0.026, 0.002), new T.MeshStandardMaterial({ map: tagTex(tag[0], tag[1]), roughness: 0.6 }), -0.11, -0.012, 0, 0, 0, 0.25);
    } else if (id === 'uv') {
      const body = new T.MeshStandardMaterial({ color: 0x3a3f48, roughness: 0.45, metalness: 0.5 });
      S2(new T.CylinderGeometry(0.016, 0.016, 0.12, 24), body, 0, 0, 0, 0, 0, Math.PI / 2);
      S2(new T.CylinderGeometry(0.022, 0.017, 0.03, 24), new T.MeshStandardMaterial({ color: 0x5b42d6, roughness: 0.3, metalness: 0.4, emissive: 0x2a1a80, emissiveIntensity: 0.8 }), -0.07, 0, 0, 0, 0, Math.PI / 2);
      S2(new T.CircleGeometry(0.018, 24), new T.MeshBasicMaterial({ color: 0xb9a8ff }), -0.0855, 0, 0, 0, -Math.PI / 2, 0);
      S2(new T.BoxGeometry(0.014, 0.006, 0.01), new T.MeshStandardMaterial({ color: 0x111111 }), 0.01, 0.017, 0);
    } else if (id === 'usb') {
      S2(new T.BoxGeometry(0.07, 0.024, 0.012), new T.MeshStandardMaterial({ map: TX.label(256, 96, '#b3261e', [{ t: 'CAAT · AUDITORÍA', f: 'bold 26px Arial', y: 50, c: '#fff' }]), roughness: 0.45 }), 0, 0, 0);
      S2(new T.BoxGeometry(0.022, 0.016, 0.006), new T.MeshStandardMaterial({ color: 0xd9dde0, metalness: 1, roughness: 0.2, envMap: World.envTex || null }), 0.046, 0, 0);
      S2(new T.SphereGeometry(0.0025, 8, 6), new T.MeshBasicMaterial({ color: 0x33ff77 }), -0.025, 0.012, 0.006);
    } else if (id === 'card_bg') {
      const [c, x] = TX.cv(512, 340); x.fillStyle = '#eef3f7'; x.fillRect(0, 0, 512, 340); x.fillStyle = '#1f4e6b'; x.fillRect(0, 0, 512, 52); x.fillStyle = '#fff'; x.font = 'bold 26px Arial'; x.fillText('MERIDIANO · emergencia.tes', 18, 34);
      x.font = 'bold 22px monospace'; x.textAlign = 'center';
      COORD.cols.forEach((cl, i) => { x.fillStyle = '#25313b'; x.fillText(cl, 130 + i * 76, 84); });
      COORD.rows.forEach((r, j) => { x.fillStyle = '#25313b'; x.fillText(String(j + 1), 60, 124 + j * 46); r.forEach((v, i) => { x.strokeStyle = '#9fb3c2'; x.strokeRect(96 + i * 76, 96 + j * 46, 68, 40); x.fillStyle = '#111'; x.fillText(pad2(v), 130 + i * 76, 124 + j * 46); }); });
      const t = TX.tex(c); S2(new T.BoxGeometry(0.12, 0.08, 0.0012), [0, 1, 2, 3].map(() => new T.MeshStandardMaterial({ color: 0xdfe7ee })).concat([new T.MeshStandardMaterial({ map: t, roughness: 0.55 }), new T.MeshStandardMaterial({ color: 0xdfe7ee })]), 0, 0, 0);
    }
