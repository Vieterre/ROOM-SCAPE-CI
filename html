// Certificado de la cámara de comercio — se dibuja en un canvas para poder triturarlo en tiras
function drawCertificate(c, w = 760, h = 980) {
  c.width = w; c.height = h; const x = c.getContext('2d');
  x.fillStyle = '#f4f0e6'; x.fillRect(0, 0, w, h);
  for (let i = 0; i < 2200; i++) { x.fillStyle = `rgba(120,100,60,${Math.random() * 0.05})`; x.fillRect(Math.random() * w, Math.random() * h, 1.5, 1.5); }
  // marca de agua guilloche
  x.strokeStyle = 'rgba(40,90,120,.10)'; x.lineWidth = 1;
  for (let k = 0; k < 26; k++) { x.beginPath(); for (let a = 0; a <= Math.PI * 2 + 0.01; a += 0.02) { const r = 210 + 18 * Math.sin(a * 9 + k * 0.4); const px = w / 2 + Math.cos(a) * r, py = 520 + Math.sin(a) * r * 0.62; a === 0 ? x.moveTo(px, py) : x.lineTo(px, py); } x.stroke(); }
  x.fillStyle = '#1d2a3a'; x.textAlign = 'center';
  x.font = 'bold 26px Georgia, serif'; x.fillText('CÁMARA DE COMERCIO DE LA CIUDAD', w / 2, 70);
  x.font = '15px Georgia, serif'; x.fillText('CERTIFICADO DE EXISTENCIA Y REPRESENTACIÓN LEGAL', w / 2, 100);
  x.fillRect(60, 118, w - 120, 2);
  x.textAlign = 'left'; x.font = '15px "Courier New", monospace'; x.fillStyle = '#1b1a17';
  const L = [
    ['Fecha de expedición:', '06/07/2026  15:42'],
    ['Razón social:', 'SERVICIOS INTEGRALES NÉBULA S.A.S.'],
    ['NIT:', '901.448.372-5'],
    ['Matrícula mercantil:', '03-718224'],
    ['Fecha de matrícula:', '02/07/2026'],
    ['Domicilio principal:', 'Carrera 14 # 82-31, Oficina 302'],
    ['Objeto social:', 'Consultoría empresarial, asesoría'],
    ['', 'administrativa y servicios integrales.'],
    ['Capital suscrito:', '$ 1.000.000'],
    ['Accionista único:', 'ELENA RUIZ ORTEGA'],
  ];
  let y = 170; L.forEach(([a, b]) => { x.fillStyle = '#5a5244'; x.fillText(a, 70, y); x.fillStyle = '#1b1a17'; x.fillText(b, 300, y); y += 34; });
  x.fillStyle = '#1d2a3a'; x.font = 'bold 17px Georgia, serif'; x.fillText('REPRESENTACIÓN LEGAL', 70, y + 20);
  x.font = '15px "Courier New", monospace'; x.fillStyle = '#1b1a17';
  x.fillText('Representante legal:  ELENA RUIZ ORTEGA', 70, y + 56);
  x.fillText('Cédula de ciudadanía: 52.871.406', 70, y + 88);
  x.fillText('Suplente:             NO REGISTRA', 70, y + 120);
  x.fillStyle = '#5a5244'; x.font = 'italic 13px Georgia, serif';
  x.fillText('La sociedad no ha renovado matrícula ni registra establecimientos de comercio.', 70, y + 170);
  x.fillText('Este certificado refleja la situación jurídica registrada a la fecha de expedición.', 70, y + 192);
  // sello
  const sx = w - 170, sy = h - 170;
  x.strokeStyle = 'rgba(120,30,40,.75)'; x.lineWidth = 3; x.beginPath(); x.arc(sx, sy, 78, 0, Math.PI * 2); x.stroke();
  x.lineWidth = 1.5; x.beginPath(); x.arc(sx, sy, 64, 0, Math.PI * 2); x.stroke();
  x.fillStyle = 'rgba(120,30,40,.8)'; x.textAlign = 'center'; x.font = 'bold 14px Georgia, serif'; x.fillText('CÁMARA DE', sx, sy - 8); x.fillText('COMERCIO', sx, sy + 10); x.font = '11px Georgia'; x.fillText('★ CERTIFICADO ★', sx, sy + 30);
  x.fillStyle = '#1d2a3a'; x.textAlign = 'left'; x.font = 'italic 22px "Segoe Script", "Brush Script MT", cursive'; x.fillText('Secretaría General', 80, h - 120);
