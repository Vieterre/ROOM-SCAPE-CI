    this.anims = this.anims.filter(a => !a.fin);
    const cam = this.camera;
    if (!S.started && !this.escaping) {
      const t = this.t; cam.position.set(Math.sin(t * 0.06) * 0.75, 1.52 + Math.sin(t * 0.11) * 0.04, 0.95 + Math.cos(t * 0.06) * 0.25);
      const yaw = Math.sin(t * 0.045) * 0.75; const tgt = cam.position.clone().add(this.dir(yaw, -0.06)); cam.lookAt(tgt);
      if (cam.fov !== 55) { cam.fov = 55; cam.updateProjectionMatrix(); }
    } else if (!this.moving && !this.escaping) {
      if (this.view === 'overview') { cam.position.copy(this.P0); cam.quaternion.copy(this.overviewQuat()); }
      else if (this.base) {
        const right = new T.Vector3(1, 0, 0).applyQuaternion(this.base.q), up = new T.Vector3(0, 1, 0).applyQuaternion(this.base.q);
