const REIMB = (() => { // conjunto de control (conforme a Benford): reembolsos de gastos 2026
  const r = mulberry32(777); const n = 268, cnt = {}; let tot = 0;
  for (let d = 10; d <= 99; d++) { cnt[d] = Math.round(n * Math.log10(1 + 1 / d)); tot += cnt[d]; }
  let diff = n - tot, d0 = 10; while (diff !== 0) { cnt[d0] += Math.sign(diff); diff -= Math.sign(diff); d0++; }
  const who = ['L. Benítez', 'M. Quintero', 'J. Ferro', 'D. Vélez', 'A. Molina', 'C. Duarte', 'S. Rendón'], mo = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov'];
  const rows = []; let id = 0;
  for (let d = 10; d <= 99; d++) for (let k = 0; k < cnt[d]; k++) {
    const mag = r() < 0.5 ? 1e3 : 1e4; const amt = Math.round(((d + r() * 0.99) * mag) / 10) * 10;
    rows.push({ id: 'g' + (id++), date: pad2(1 + Math.floor(r() * 28)) + '-' + mo[Math.floor(r() * 11)], vendor: 'Reembolso · ' + who[Math.floor(r() * who.length)], inv: 'LG-' + (200 + Math.floor(r() * 700)), amt, appr: 'amolina', time: pad2(9 + Math.floor(r() * 8)) + ':' + pad2(Math.floor(r() * 60)), neb: false });
  }
  return rows;
})();
const BEN_SETS = { pagos: { name: 'Pagos con atribución ≤ $10 M · jul–nov 2026', rows: BENFORD }, gastos: { name: 'Reembolsos de gastos de viaje · 2026', rows: REIMB } };
function benStats(rows, test) {
  const n = rows.length, lo = test === 'd1' ? 1 : 10, hi = test === 'd1' ? 9 : 99, f = test === 'd1' ? benD1 : benD2;
  const obs = {}; for (let d = lo; d <= hi; d++) obs[d] = 0; rows.forEach(x => obs[f(x.amt)]++);
  const bins = []; let mad = 0;
  for (let d = lo; d <= hi; d++) {
    const pe = Math.log10(1 + 1 / d), po = obs[d] / n, dev = Math.abs(po - pe);
    const cc = 1 / (2 * n); const zn = dev > cc ? dev - cc : dev; const z = zn / Math.sqrt(pe * (1 - pe) / n);
    mad += dev; bins.push({ d, c: obs[d], po, pe, z, hi: z > 1.96 && po > pe });
  }
  mad /= bins.length;
  const th = test === 'd1' ? [0.006, 0.012, 0.015] : [0.0012, 0.0018, 0.0022];
  const conf = mad <= th[0] ? 'conformidad cercana' : mad <= th[1] ? 'conformidad aceptable' : mad <= th[2] ? 'conformidad marginal' : 'no conformidad';
  return { n, bins, mad, conf };
}

