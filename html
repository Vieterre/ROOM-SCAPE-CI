    for (const [k, [x, y, w, h]] of Object.entries(MAP_ZONES)) s += `<g class="mapzone ${this.st === k ? 'on' : ''}" data-s="${k}"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="4" fill="#232a33" stroke="#7d858c" stroke-width="2"/><text x="${x + w / 2}" y="${y + h / 2 + (k === 'door' ? 34 : 0)}" fill="#d8d2c2" font-size="15" text-anchor="middle" dominant-baseline="middle" font-family="Arial" ${['keycab', 'board', 'grc'].includes(k) ? `transform="rotate(-90 ${x + w / 2} ${y + h / 2})"` : ''}>${STATIONS[k].name}</text></g>`;
    s += `<text x="0" y="0" fill="#6b737b" font-size="13" text-anchor="middle" font-family="Arial">Sala de Custodia S-2 · plano</text>`;
