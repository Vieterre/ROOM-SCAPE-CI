const BILL_COL = { 100000: ['#8fbfa5', '#5d8f75'], 50000: ['#c4a0cc', '#8d6596'], 20000: ['#dcbc77', '#a4823e'], 10000: ['#d09a8a', '#9b6555'], 5000: ['#9fb2d2', '#6a7fa3'], 2000: ['#a9c995', '#71925c'] };
function billHTML(bl, fakeMarked) {
  if (bl.coin) return `<div class="coin" style="background:radial-gradient(circle at 35% 30%,${bl.den === 1000 ? '#f3dc8b,#b9902f' : '#e8e8e2,#9c9c94'})" data-b="${bl.id}">${fmtN(bl.den)}</div>`;
  const [c1, c2] = BILL_COL[bl.den]; const fake = !!bl.fake; const r = mulberry32(bl.id.length * 977 + bl.den);
  let fibers = '';
  if (!fake) for (let i = 0; i < 26; i++) { const x = r() * 132, y = r() * 62, a = r() * 6.28, l = 3 + r() * 5, col = ['#39ff8a', '#ffe14a', '#ff5ad8', '#6ad7ff'][i % 4]; fibers += `<line x1="${x}" y1="${y}" x2="${x + Math.cos(a) * l}" y2="${y + Math.sin(a) * l}" stroke="${col}" stroke-width="1.1"/>`; }
  const uv = fake ? `<div class="uvlayer" style="background:#d6e6ff;box-shadow:inset 0 0 24px #9cc4ff"></div>`
    : `<div class="uvlayer" style="background:#160f33"><svg width="132" height="62" style="position:absolute;inset:0">${fibers}<rect x="86" y="16" width="34" height="30" rx="4" fill="none" stroke="#7dffb0" stroke-width="1.5" opacity=".9"/><text x="103" y="37" font-size="12" text-anchor="middle" fill="#7dffb0" font-family="monospace">${bl.den / 1000}</text></svg></div>`;
  return `<div class="bill${fakeMarked ? ' fake' : ''}" data-b="${bl.id}" style="background:linear-gradient(135deg,${fake ? '#cfa9d6' : c1},${fake ? '#9a74a5' : c2})">
