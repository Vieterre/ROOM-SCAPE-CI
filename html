<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CUATRO OJOS — Escape room de control interno</title>
<meta name="description" content="Escape room 3D point-and-click sobre control interno, gestión de riesgos, segregación de funciones, conciliaciones y detección de fraude.">
<style>
:root{
  --bg:#06080b; --panel:#10141a; --panel2:#161b22; --panel3:#1d232b; --line:rgba(255,255,255,.09); --line2:rgba(255,255,255,.16);
  --ink:#ebe6dc; --muted:#9aa4ad; --dim:#69737c;
  --brass:#d4a24c; --brass2:#f2c46d; --red:#e5484d; --red2:#ff6b6f; --green:#3fb950; --green2:#62d17a; --cyan:#4fc3c7; --amber:#f5a524; --violet:#a78bfa;
  --paper:#f4efe2; --paper2:#ebe3d1; --paper-ink:#23201a; --paper-line:#cdc3ab; --paper-muted:#6f6758;
  --ui:"Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --serif:Georgia,"Times New Roman",Times,serif;
  --mono:"JetBrains Mono","Cascadia Mono",Consolas,"SF Mono",Menlo,"Liberation Mono",monospace;
  --type:"Courier Prime","Courier New",Courier,monospace;
  --hand:"Segoe Print","Bradley Hand","Marker Felt","Comic Sans MS",cursive;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#000;color:var(--ink);font-family:var(--ui);overflow:hidden;-webkit-user-select:none;user-select:none;-webkit-font-smoothing:antialiased}
button{font-family:inherit;color:inherit}
.hidden{display:none!important}
#app{position:fixed;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 40%,#151a20 0%,#05070a 70%)}
#gl{position:absolute;inset:0;width:100%;height:100%;display:block;outline:none}
#gl.grab{cursor:grab} #gl.grabbing{cursor:grabbing} #gl.point{cursor:pointer}
.fx{pointer-events:none;position:absolute;inset:0}
.fx-vignette{background:radial-gradient(ellipse at 50% 50%,rgba(0,0,0,0) 52%,rgba(0,0,0,.42) 82%,rgba(0,0,0,.78) 100%)}
.fx-grain{opacity:.055;mix-blend-mode:overlay;background-size:160px 160px;animation:grain 1.2s steps(6) infinite}
@keyframes grain{0%{background-position:0 0}20%{background-position:-40px 30px}40%{background-position:30px -50px}60%{background-position:-60px -20px}80%{background-position:50px 40px}100%{background-position:0 0}}
.fx-red{background:radial-gradient(ellipse at 50% 0%,rgba(229,72,77,.0) 0%,rgba(229,72,77,0) 60%);transition:opacity .6s}
.fx-flash{background:#fff;opacity:0;transition:opacity 1.6s ease}
.fx-dim{background:#000;opacity:0;transition:opacity .5s ease}

/* ---------- HUD ---------- */
#hud{position:absolute;inset:0;pointer-events:none;z-index:10}
#hud > *{pointer-events:auto}
.hud-tl{position:absolute;left:18px;top:14px;display:flex;flex-direction:column;gap:6px;pointer-events:none}
.clockbox{display:flex;align-items:baseline;gap:10px;font-family:var(--mono);text-shadow:0 1px 8px rgba(0,0,0,.8)}
.clockbox .t{font-size:26px;letter-spacing:1px;color:#f1ece2}
.clockbox small{color:var(--muted);font-family:var(--ui);font-size:12px;letter-spacing:.4px}
.batchbox{display:flex;align-items:center;gap:8px;font-size:12.5px;color:#f3c9c9;background:rgba(40,8,10,.55);border:1px solid rgba(229,72,77,.35);padding:5px 10px 5px 8px;border-radius:999px;backdrop-filter:blur(4px)}
.batchbox b{font-family:var(--mono);font-size:13.5px;color:#fff}
.batchbox.safe{color:#cdeccf;background:rgba(8,36,16,.55);border-color:rgba(63,185,80,.45)}
.batchbox.done{color:#ffd9a8;background:rgba(48,28,6,.6);border-color:rgba(245,165,36,.45)}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(229,72,77,.7);animation:pulse 1.6s infinite}
.batchbox.safe .pulse{background:var(--green);animation:none}
.batchbox.done .pulse{background:var(--amber);animation:none}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(229,72,77,.7)}70%{box-shadow:0 0 0 9px rgba(229,72,77,0)}100%{box-shadow:0 0 0 0 rgba(229,72,77,0)}}
.hud-tc{position:absolute;left:50%;top:14px;transform:translateX(-50%);text-align:center;pointer-events:none;max-width:56vw}
.hud-tc .loc{font-family:var(--serif);font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#d9cfbd;text-shadow:0 1px 10px #000}
.hud-tc .obj{margin-top:6px;font-size:13px;color:#cfd6dc;background:rgba(8,11,15,.55);border:1px solid var(--line);padding:6px 12px;border-radius:8px;backdrop-filter:blur(4px);display:inline-block}
.hud-tc .obj b{color:var(--brass2);font-weight:600}
.hud-tr{position:absolute;right:16px;top:14px;display:flex;gap:8px}
.hbtn{position:relative;width:44px;height:44px;border-radius:12px;border:1px solid var(--line2);background:rgba(14,18,23,.72);backdrop-filter:blur(6px);display:grid;place-items:center;cursor:pointer;transition:all .18s;color:#e9e3d6}
.hbtn:hover{background:rgba(32,38,46,.9);border-color:rgba(212,162,76,.55);transform:translateY(-1px)}
.hbtn svg{width:22px;height:22px}
.hbtn .badge{position:absolute;right:-5px;top:-6px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--brass);color:#1a1307;font-size:11px;font-weight:700;display:grid;place-items:center;font-family:var(--mono)}
.hbtn .badge.zero{display:none}
.hbtn.flash{animation:hflash 1.2s ease 2}
@keyframes hflash{0%,100%{box-shadow:0 0 0 0 rgba(242,196,109,0)}50%{box-shadow:0 0 0 6px rgba(242,196,109,.35)}}
.backbtn{position:absolute;left:18px;bottom:22px;height:44px;padding:0 18px 0 14px;border-radius:12px;border:1px solid var(--line2);background:rgba(14,18,23,.78);backdrop-filter:blur(6px);cursor:pointer;font-size:14px;letter-spacing:.3px;display:flex;align-items:center;gap:8px;transition:all .18s}
.backbtn:hover{border-color:rgba(212,162,76,.6);background:rgba(32,38,46,.92)}
.backbtn svg{width:18px;height:18px}
.inventory{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:flex;gap:8px;padding:8px;border-radius:16px;background:rgba(10,13,17,.62);border:1px solid var(--line);backdrop-filter:blur(8px);min-height:68px;align-items:center}
.inventory:empty::before{content:"Inventario vacío";color:var(--dim);font-size:12px;padding:0 14px;letter-spacing:.5px}
.slot{width:56px;height:56px;border-radius:12px;background:linear-gradient(180deg,#1c222a,#12161c);border:1px solid var(--line2);display:grid;place-items:center;cursor:pointer;position:relative;transition:transform .15s,border-color .15s}
.slot:hover{transform:translateY(-3px);border-color:var(--brass)}
.slot svg{width:40px;height:40px}
.slot.new{animation:slotnew 1.4s ease}
@keyframes slotnew{0%{transform:scale(.4);opacity:0}50%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}
.tooltip{position:absolute;pointer-events:none!important;padding:6px 10px;border-radius:8px;background:rgba(8,10,14,.86);border:1px solid rgba(212,162,76,.45);font-size:13px;white-space:nowrap;transform:translate(14px,14px);opacity:0;transition:opacity .12s;z-index:30;color:#f1ead9;box-shadow:0 6px 24px rgba(0,0,0,.5)}
.tooltip small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.tooltip.on{opacity:1}
.caption{position:absolute;left:50%;bottom:104px;transform:translateX(-50%);max-width:min(720px,80vw);background:rgba(8,10,14,.88);border:1px solid var(--line2);border-radius:12px;padding:10px 18px;font-family:var(--serif);font-size:15px;line-height:1.55;color:#eee6d6;text-align:center;opacity:0;transition:opacity .25s;pointer-events:none!important;z-index:15;box-shadow:0 10px 30px rgba(0,0,0,.45)}
.caption.on{opacity:1}
.draghint{position:absolute;left:50%;bottom:98px;transform:translateX(-50%);font-size:12.5px;color:#cbd2d8;background:rgba(8,10,14,.55);padding:6px 14px;border-radius:999px;border:1px solid var(--line);pointer-events:none!important;transition:opacity 1s}
.draghint.off{opacity:0}

/* ---------- Toasts ---------- */
#toasts{position:absolute;right:16px;top:72px;display:flex;flex-direction:column;gap:8px;z-index:60;pointer-events:none;width:340px}
.toast{background:rgba(14,18,23,.94);border:1px solid var(--line2);border-left:3px solid var(--cyan);padding:10px 12px 10px 12px;border-radius:10px;font-size:13px;line-height:1.4;box-shadow:0 10px 30px rgba(0,0,0,.5);animation:toastin .35s ease;display:flex;gap:10px;align-items:flex-start}
.toast .ti{font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
.toast.item{border-left-color:var(--brass)} .toast.item .ti{color:var(--brass2)}
.toast.finding{border-left-color:var(--red)} .toast.finding .ti{color:#ff9b9e}
.toast.ok{border-left-color:var(--green)} .toast.ok .ti{color:var(--green2)}
.toast.warn{border-left-color:var(--amber)} .toast.warn .ti{color:var(--amber)}
.toast.out{animation:toastout .4s ease forwards}
@keyframes toastin{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}
@keyframes toastout{to{opacity:0;transform:translateX(30px)}}

/* ---------- Overlay ---------- */
.overlay{position:absolute;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:24px}
.ov-backdrop{position:absolute;inset:0;background:rgba(3,5,8,.68);backdrop-filter:blur(5px) saturate(.75);animation:fadein .25s ease}
.ov-window{position:relative;max-width:min(1240px,96vw);max-height:94vh;display:flex;flex-direction:column;animation:ovin .32s cubic-bezier(.2,.8,.2,1);min-width:min(420px,94vw)}
@keyframes ovin{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}
@keyframes fadein{from{opacity:0}to{opacity:1}}
.ov-head{display:flex;align-items:center;gap:10px;padding:0 4px 10px 4px;color:#e2dccf}
.ov-head .ttl{font-family:var(--serif);font-size:15px;letter-spacing:2.2px;text-transform:uppercase;flex:1;text-shadow:0 2px 10px #000;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ov-head .ttl small{font-family:var(--ui);letter-spacing:.4px;text-transform:none;color:var(--muted);font-size:12px;margin-left:10px}
.ovbtn{height:36px;min-width:36px;padding:0 12px;border-radius:10px;border:1px solid var(--line2);background:rgba(18,22,28,.9);cursor:pointer;display:flex;align-items:center;gap:6px;font-size:13px;transition:all .15s}
.ovbtn:hover{border-color:var(--brass);background:#232a33}
.ovbtn svg{width:16px;height:16px}
.ov-body{overflow:auto;border-radius:14px;scrollbar-width:thin;scrollbar-color:#3a424c transparent}
.ov-body::-webkit-scrollbar{width:10px;height:10px}.ov-body::-webkit-scrollbar-thumb{background:#3a424c;border-radius:5px}

/* ---------- Generic buttons & chips ---------- */
.btn{height:38px;padding:0 16px;border-radius:10px;border:1px solid var(--line2);background:#1b2129;cursor:pointer;font-size:14px;transition:all .15s;display:inline-flex;align-items:center;gap:8px;justify-content:center;color:#ebe6dc;white-space:nowrap}
.btn:hover{border-color:var(--brass);background:#242b35}
.btn.primary{background:linear-gradient(180deg,#e0b25c,#b98a36);color:#1b1306;border-color:#e9be6c;font-weight:600}
.btn.primary:hover{filter:brightness(1.08)}
.btn.danger{background:#3a1416;border-color:#7a2a2e;color:#ffd2d3}
.btn.ghost{background:transparent}
.btn.sm{height:30px;padding:0 10px;font-size:12.5px;border-radius:8px}
.btn:disabled{opacity:.45;cursor:not-allowed;filter:grayscale(.6)}
.chip{display:inline-flex;align-items:center;gap:5px;height:26px;padding:0 9px;border-radius:7px;border:1px solid var(--line2);background:#161b21;font-size:12px;cursor:pointer;font-family:var(--mono);color:#cfd5da;transition:all .12s;margin:2px}
.chip:hover{border-color:var(--brass)}
.chip.on{background:#4a1d20;border-color:#e5484d;color:#ffd7d8}
.chip.ok.on{background:#173322;border-color:#3fb950;color:#cdf5d5}
.chip.sel.on{background:#3b2f14;border-color:var(--brass);color:#ffe7b5}
.select{height:36px;border-radius:9px;border:1px solid var(--line2);background:#141920;color:#e8e2d6;padding:0 10px;font-size:13px;cursor:pointer;max-width:100%}
.select:hover{border-color:var(--brass)}
.select option{background:#141920}
.feedback{margin-top:10px;font-size:13px;min-height:20px;line-height:1.45}
.feedback.err{color:#ff9fa2}.feedback.ok{color:#8fe3a1}.feedback.info{color:#cfd6dc}
.shake{animation:shake .4s}
@keyframes shake{0%,100%{transform:none}20%{transform:translateX(-7px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}

/* ---------- Tool panels (puzzles) ---------- */
.tool{background:linear-gradient(180deg,#141920,#0e1217);border:1px solid var(--line2);border-radius:14px;padding:18px 20px;color:#e6e1d6;box-shadow:0 30px 80px rgba(0,0,0,.55)}
.tool h3{margin:0 0 4px 0;font-family:var(--serif);font-weight:normal;letter-spacing:1.6px;font-size:18px;color:#f1e7d2}
.tool .sub{color:var(--muted);font-size:13px;margin-bottom:14px;line-height:1.5}
.tool .sec{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--brass2);margin:14px 0 8px}
.tool table{border-collapse:collapse;width:100%;font-size:12.5px}
.tool th{font-weight:600;color:#cdbf9f;text-align:left;padding:6px 8px;border-bottom:1px solid var(--line2);font-size:11.5px;letter-spacing:.5px;text-transform:uppercase}
.tool td{padding:6px 8px;border-bottom:1px solid var(--line)}
.tool .num{font-family:var(--mono);text-align:right;white-space:nowrap}
.tool .row{display:flex;gap:16px;flex-wrap:wrap}
.tool .col{flex:1;min-width:260px}
.tool .actions{display:flex;gap:10px;align-items:center;margin-top:14px;flex-wrap:wrap}
.tool .note{font-size:12px;color:var(--muted);line-height:1.5}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:13px}
.kv div:nth-child(odd){color:var(--muted)}
.tag{display:inline-block;padding:1px 7px;border-radius:5px;font-size:11px;font-family:var(--mono);border:1px solid var(--line2);color:#cfd5da}
.tag.red{border-color:#7a2a2e;color:#ff9fa2;background:#2a0f11}
.tag.green{border-color:#24622f;color:#8fe3a1;background:#0e2415}
.tag.amber{border-color:#7a5413;color:#ffd08a;background:#2a1d06}
.tag.cyan{border-color:#1f5b5d;color:#9de6e8;background:#0b2223}

/* ---------- Paper documents ---------- */
.paperwrap{padding:6px 6px 14px}
.paper{position:relative;width:min(780px,92vw);background:var(--paper);color:var(--paper-ink);padding:44px 52px 48px;border-radius:3px;box-shadow:0 30px 70px rgba(0,0,0,.6),0 2px 0 #d8cfba inset;font-family:var(--serif);font-size:14.5px;line-height:1.58;background-image:radial-gradient(circle at 18% 12%,rgba(255,255,255,.55),rgba(255,255,255,0) 40%),radial-gradient(circle at 80% 90%,rgba(160,140,100,.12),rgba(0,0,0,0) 45%),repeating-linear-gradient(0deg,rgba(0,0,0,.012) 0 1px,transparent 1px 3px)}
.paper.narrow{width:min(560px,92vw)}
.paper.wide{width:min(980px,94vw)}
.paper.typed{font-family:var(--type);font-size:13.5px}
.paper h1{font-family:var(--serif);font-size:20px;letter-spacing:1.6px;margin:0 0 4px;text-transform:uppercase;font-weight:normal}
.paper h2{font-size:14px;letter-spacing:1.2px;text-transform:uppercase;margin:20px 0 6px;font-weight:bold;border-bottom:1px solid var(--paper-line);padding-bottom:3px}
.paper p{margin:6px 0}
.paper .meta{font-family:var(--ui);font-size:11.5px;color:var(--paper-muted);letter-spacing:.4px;text-transform:uppercase}
.paper .lh{display:flex;align-items:center;gap:12px;border-bottom:2px solid var(--paper-ink);padding-bottom:10px;margin-bottom:16px}
.paper .lh .brand{font-family:var(--serif);letter-spacing:4px;font-size:15px}
.paper .lh .brand small{display:block;letter-spacing:1.2px;font-size:10px;color:var(--paper-muted);font-family:var(--ui)}
.paper .lh .code{margin-left:auto;text-align:right;font-family:var(--ui);font-size:11px;color:var(--paper-muted)}
.paper table{border-collapse:collapse;width:100%;font-family:var(--ui);font-size:12.5px;margin:8px 0}
.paper th{background:#e4dbc6;text-align:left;padding:5px 7px;border:1px solid #c9bea3;font-size:11.5px}
.paper td{padding:5px 7px;border:1px solid #d6ccb5;vertical-align:top}
.paper td.num,.paper th.num{text-align:right;font-family:var(--mono);white-space:nowrap}
.paper .hl{background:rgba(255,214,102,.55);padding:0 2px}
.paper ul,.paper ol{margin:6px 0;padding-left:22px}
.paper li{margin:3px 0}
.stamp{position:absolute;border:3px solid rgba(185,40,40,.72);color:rgba(185,40,40,.78);font-family:var(--ui);font-weight:800;letter-spacing:3px;padding:4px 12px;border-radius:6px;transform:rotate(-11deg);text-transform:uppercase;font-size:16px;mix-blend-mode:multiply}
.stamp.blue{border-color:rgba(40,70,160,.6);color:rgba(40,70,160,.7)}
.stamp.green{border-color:rgba(30,120,60,.6);color:rgba(30,120,60,.75)}
.sig{font-family:var(--hand);font-size:20px;color:#233a7a;transform:rotate(-4deg);display:inline-block}
.hand{font-family:var(--hand);color:#2a3f8f}
.sticky{position:relative;background:#ffe680;color:#3a3110;font-family:var(--hand);padding:14px 16px;box-shadow:0 8px 18px rgba(0,0,0,.28);transform:rotate(-2.2deg);width:260px;font-size:15px;line-height:1.35}
.sticky.pink{background:#ffb3c7}
.sticky::before{content:"";position:absolute;left:50%;top:-9px;width:70px;height:18px;transform:translateX(-50%) rotate(2deg);background:rgba(255,255,255,.55);box-shadow:0 1px 2px rgba(0,0,0,.1)}
.redacted{background:#1d1b17;color:transparent;border-radius:2px}
.checkbox{display:inline-block;width:12px;height:12px;border:1.5px solid #3b352a;margin-right:5px;vertical-align:-1px;position:relative}
.checkbox.x::after{content:"✕";position:absolute;left:0;top:-4px;font-size:12px;font-weight:bold;color:#1d1b17}
.doc-foot{margin-top:22px;font-family:var(--ui);font-size:11px;color:var(--paper-muted);border-top:1px solid var(--paper-line);padding-top:8px}
.paper .grid2{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px}
.paper .lbl{font-family:var(--ui);font-size:11px;color:var(--paper-muted);text-transform:uppercase;letter-spacing:.5px}

/* ---------- Petty cash ---------- */
.cash{display:grid;grid-template-columns:1.35fr 1fr;gap:18px}
.billgrid{display:flex;flex-wrap:wrap;gap:8px}
.bill{width:132px;height:62px;border-radius:5px;position:relative;cursor:pointer;overflow:hidden;box-shadow:0 2px 6px rgba(0,0,0,.4);transition:transform .12s;font-family:var(--serif);color:rgba(30,30,30,.85)}
.bill:hover{transform:translateY(-2px)}
.bill .face{position:absolute;inset:0;padding:6px 8px;display:flex;flex-direction:column;justify-content:space-between}
.bill .den{font-size:17px;font-weight:bold;letter-spacing:.5px}
.bill .bk{font-size:8.5px;letter-spacing:1.6px;text-transform:uppercase;opacity:.75}
.bill .portrait{position:absolute;right:8px;top:8px;width:30px;height:40px;border-radius:50%;background:rgba(0,0,0,.12);box-shadow:inset 0 0 0 2px rgba(0,0,0,.08)}
.bill .thread{position:absolute;top:0;bottom:0;left:48%;width:3px;background:repeating-linear-gradient(180deg,rgba(60,60,60,.55) 0 4px,rgba(200,200,200,.4) 4px 7px)}
.bill .fibers{display:none;position:absolute;inset:0}
.bill.uv{filter:none}
.bill .uvlayer{display:none;position:absolute;inset:0}
.uvmode .bill .uvlayer{display:block}
.uvmode .bill .face,.uvmode .bill .thread,.uvmode .bill .portrait{opacity:.18}
.bill .mark{position:absolute;left:6px;bottom:4px;font-family:var(--ui);font-size:10px;font-weight:700;letter-spacing:1px;padding:1px 5px;border-radius:4px;background:#5c1215;color:#ffd3d4;display:none}
.bill.fake .mark{display:block}
.bill.fake{outline:2px solid var(--red);outline-offset:1px}
.coin{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;font-family:var(--serif);font-weight:bold;font-size:13px;color:#3a2f15;box-shadow:inset 0 0 0 3px rgba(0,0,0,.12),0 2px 5px rgba(0,0,0,.45)}
.vouchers{display:flex;flex-direction:column;gap:8px}
.voucher{background:#f1ead8;color:#2a251d;border-radius:4px;padding:8px 10px;font-size:12px;display:grid;grid-template-columns:1fr auto;gap:4px 10px;box-shadow:0 2px 6px rgba(0,0,0,.35);border-left:4px solid #b8ab8a}
.voucher .vt{font-family:var(--serif);font-size:13.5px;font-weight:bold}
.voucher .vamt{font-family:var(--mono);font-weight:bold;font-size:13px;text-align:right;color:#2a251d}
.voucher .vd{color:#5c5446;grid-column:1/3;font-size:11.5px;line-height:1.4}
.voucher .vs{grid-column:1/3;display:flex;gap:6px;align-items:center;justify-content:flex-end}
.voucher.acc{border-left-color:#2f8f46}.voucher.rej{border-left-color:#b93a3e;opacity:.88}
.acta{background:var(--paper);color:var(--paper-ink);border-radius:4px;padding:16px 18px;font-family:var(--serif);box-shadow:0 10px 30px rgba(0,0,0,.4)}
.acta h4{margin:0 0 8px;letter-spacing:2px;text-transform:uppercase;font-size:14px}
.acta .line{display:flex;justify-content:space-between;border-bottom:1px dotted #b9ae94;padding:5px 0;font-size:13.5px}
.acta .line b{font-family:var(--mono)}
.acta .line.total{border-bottom:2px solid #3b352a;font-weight:bold}
.acta .line.diff b{color:#a3262b}
.policy{background:#e9e1cc;color:#2d281f;border-radius:4px;padding:10px 12px;font-size:12px;line-height:1.5;margin-top:12px;font-family:var(--ui)}
.policy b{font-family:var(--serif);letter-spacing:1px}

/* ---------- SoD matrix ---------- */
.matrix td,.matrix th{text-align:center}
.matrix td:first-child,.matrix th:first-child{text-align:left}
.matrix .yes{color:#ffd08a;font-weight:bold;font-size:14px}
.matrix .no{color:#46505a}
.rules{font-size:12.5px;line-height:1.55}
.rules div{padding:3px 0;border-bottom:1px solid var(--line)}
.rules b{font-family:var(--mono);color:var(--brass2)}
.userrow{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
.userrow .un{width:118px;font-family:var(--mono);font-size:12.5px}
.userrow .un small{display:block;color:var(--muted);font-family:var(--ui);font-size:10.5px}

/* ---------- GRC heat map ---------- */
.grc{display:grid;grid-template-columns:auto 1fr;gap:22px}
.heat{display:grid;grid-template-columns:34px repeat(5,74px);grid-template-rows:repeat(5,64px) 34px;gap:4px}
.heat .ax{display:grid;place-items:center;color:var(--muted);font-family:var(--mono);font-size:12px}
.heat .cell{border-radius:6px;position:relative;cursor:pointer;display:flex;flex-wrap:wrap;align-content:center;justify-content:center;gap:3px;padding:3px;transition:outline .1s;outline:1px solid rgba(0,0,0,.25)}
.heat .cell:hover{outline:2px solid #fff}
.heat .cell .sc{position:absolute;right:4px;bottom:2px;font-size:10px;font-family:var(--mono);color:rgba(0,0,0,.5)}
.z1{background:#2f7d4a}.z2{background:#b9a73a}.z3{background:#c9772e}.z4{background:#b83236}
.token{height:24px;padding:0 6px;border-radius:12px;background:#0f1318;color:#f3eee3;font-family:var(--mono);font-size:11px;display:grid;place-items:center;border:1.5px solid rgba(255,255,255,.75);cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.5);transition:transform .12s}
.token:hover{transform:scale(1.08)}
.token.sel{background:#f2c46d;color:#1b1306;border-color:#fff;box-shadow:0 0 0 3px rgba(242,196,109,.45)}
.axlbl{grid-column:2/7;text-align:center;color:var(--muted);font-size:11px;letter-spacing:1.4px;text-transform:uppercase}
.riskcard{background:#0f1318;border:1px solid var(--line2);border-radius:10px;padding:12px 14px;font-size:12.5px;line-height:1.5;min-height:150px}
.riskcard h5{margin:0 0 6px;font-size:13.5px;color:#f1e7d2}
.ctl{display:flex;gap:8px;align-items:center;padding:3px 0}
.ctl .cid{font-family:var(--mono);color:var(--brass2);width:28px}

/* ---------- Reconciliation ---------- */
.recon{display:grid;grid-template-columns:1fr 1fr 1.1fr;gap:14px;min-width:1080px}
.ledger{background:#0f1318;border:1px solid var(--line2);border-radius:10px;overflow:hidden}
.ledger .lh2{padding:8px 10px;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:#d6c8a8;background:#161b22;border-bottom:1px solid var(--line2);display:flex;justify-content:space-between}
.ledger .ln{display:grid;grid-template-columns:44px 1fr 92px 22px;gap:6px;padding:5px 8px;font-size:11.5px;border-bottom:1px solid var(--line);cursor:pointer;align-items:center;transition:background .1s}
.ledger .ln:hover{background:#1a2029}
.ledger .ln .d{font-family:var(--mono);color:var(--muted)}
.ledger .ln .a{font-family:var(--mono);text-align:right}
.ledger .ln .a.neg{color:#ffb4b6}.ledger .ln .a.pos{color:#a6e9b4}
.ledger .ln .tk{font-family:var(--mono);font-weight:bold;color:var(--green2);text-align:center}
.ledger .ln.sel{background:#3b2f14;outline:1px solid var(--brass)}
.ledger .ln.paired{opacity:.55}
.ledger .ln.paired .tk{color:var(--green2)}
.ledger .ln.diffp .tk{color:var(--amber)}
.ledger .bal{display:flex;justify-content:space-between;padding:7px 10px;font-size:12px;background:#141920;font-family:var(--mono)}
.recitem{display:grid;grid-template-columns:1fr auto;gap:4px 8px;padding:7px 8px;border-bottom:1px solid var(--line);font-size:12px}
.recitem .ra{font-family:var(--mono);text-align:right}
.recitem select{grid-column:1/3;width:100%;height:30px;font-size:12px}
.stmt{font-family:var(--mono);font-size:12px;background:#0b0e12;border:1px solid var(--line2);border-radius:8px;padding:10px 12px;margin-top:10px}
.stmt .r{display:flex;justify-content:space-between;padding:2px 0}
.stmt .r.t{border-top:1px solid var(--line2);margin-top:3px;padding-top:4px;font-weight:bold}
.stmt .r.bad{color:#ff9fa2}.stmt .r.good{color:#8fe3a1}

/* ---------- Envelopes ---------- */
.envs{display:flex;gap:18px;flex-wrap:wrap;justify-content:center}
.env{width:300px;height:196px;position:relative;border-radius:6px;background:linear-gradient(160deg,#dcc493,#c5a56d);box-shadow:0 14px 30px rgba(0,0,0,.5);color:#3b2c12;font-family:var(--type);overflow:hidden;transition:background .3s}
.env .flap{position:absolute;left:0;right:0;top:0;height:96px;background:linear-gradient(180deg,#d2b57f,#c09e66);clip-path:polygon(0 0,100% 0,50% 100%);transition:background .3s}
.env .tape{position:absolute;left:22px;right:22px;top:70px;height:34px;background:repeating-linear-gradient(90deg,rgba(232,234,242,.95) 0 3px,rgba(214,218,228,.95) 3px 5px);box-shadow:0 1px 3px rgba(0,0,0,.18);display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-family:var(--mono);font-size:11px;color:#22324f;font-weight:bold;letter-spacing:.5px;overflow:hidden}
.env .tape .bc{width:70px;height:18px;background:repeating-linear-gradient(90deg,#22324f 0 1px,transparent 1px 3px,#22324f 3px 5px,transparent 5px 6px)}
.env .tape .uvpat{position:absolute;inset:0;display:none;background-repeat:repeat-x;background-position:4px center}
.env .tape .void{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-around;color:rgba(150,40,40,.28);font-size:15px;font-weight:900;letter-spacing:4px}
.env .lbl{position:absolute;left:16px;right:16px;top:112px;font-size:11px;line-height:1.45}
.env .lbl b{font-size:12px}
.env .hw{position:absolute;left:16px;bottom:8px;font-family:var(--hand);font-size:12px;color:#26357a}
.uvmode .env{background:linear-gradient(160deg,#241a4a,#17112f);color:#5d5591}
.uvmode .env .flap{background:linear-gradient(180deg,#2a1f55,#1d1640)}
.uvmode .env .hw{color:#4c4685}
.uvmode .env .tape{background:#140f33;color:#3b3570;box-shadow:none}
.uvmode .env .tape .bc{opacity:.25}
.uvmode .env .tape>span{opacity:.12}
.uvmode .env .tape .uvpat{display:block;filter:drop-shadow(0 0 3px #39ff8a)}
.uvmode .env .tape.fake{background:#d7e6ff;color:#8aa0c8;box-shadow:0 0 18px rgba(170,200,255,.75)}
.uvmode .env .tape .void{color:rgba(255,90,90,.95);text-shadow:0 0 8px rgba(255,60,60,.8)}
.env.chosen{outline:3px solid var(--green);outline-offset:3px}
.env.bad{outline:3px solid var(--red);outline-offset:3px;opacity:.65}
.envcol{display:flex;flex-direction:column;align-items:center;gap:10px}
.uvbar{display:flex;gap:10px;align-items:center;justify-content:center;margin:6px 0 16px}
.uvbtn.on{background:linear-gradient(180deg,#5b3fd6,#3a2394);border-color:#9b86ff;color:#efeaff;box-shadow:0 0 20px rgba(140,110,255,.45)}
.reveal{margin:12px auto 0;max-width:420px;background:#f6f2e7;color:#1d1a14;border-radius:4px;padding:14px 18px;font-family:var(--type);text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.45);animation:ovin .4s}
.reveal .code{font-family:var(--mono);font-size:34px;letter-spacing:12px;margin:6px 0;color:#0d0c0a}

/* ---------- Shredder strips ---------- */
.strips{display:flex;justify-content:center;gap:5px;padding:10px;background:#0c0f13;border-radius:10px;border:1px solid var(--line2)}
.strips canvas{display:block}
.strip{cursor:pointer;position:relative;transition:transform .15s, box-shadow .15s;box-shadow:0 3px 8px rgba(0,0,0,.6)}
.strip:hover{transform:translateY(-4px)}
.strip.sel{transform:translateY(-10px);box-shadow:0 0 0 3px var(--brass),0 10px 20px rgba(0,0,0,.6)}
.strip.locked{cursor:default}
.strips.done{gap:0}
.strips.done .strip{box-shadow:none;transform:none}

/* ---------- Keypad ---------- */
.keypad{display:grid;grid-template-columns:repeat(3,62px);gap:8px}
.key{height:52px;border-radius:10px;border:1px solid #3b434d;background:linear-gradient(180deg,#2a313a,#1a1f26);font-family:var(--mono);font-size:20px;cursor:pointer;color:#e9e3d6;box-shadow:0 3px 0 #0b0d10;transition:transform .06s}
.key:active{transform:translateY(2px);box-shadow:0 1px 0 #0b0d10}
.key.fn{font-size:13px;font-family:var(--ui)}
.slots{display:flex;gap:6px}
.dslot{width:36px;height:46px;border-radius:8px;border:1px solid #3b434d;background:#0a0c0f;display:grid;place-items:center;font-family:var(--mono);font-size:22px;color:#ff8a8d;cursor:pointer}
.dslot.act{border-color:var(--brass);box-shadow:0 0 0 2px rgba(212,162,76,.3)}
.dslot.ok{color:#8fe3a1}
.dlabel{font-size:11px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted);margin:10px 0 6px}

/* ---------- Door panel ---------- */
.doorpanel{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start}
.lcd{background:#120607;border:1px solid #4b1a1c;border-radius:10px;padding:12px 14px;font-family:var(--mono);color:#ff6b6f;font-size:13px;line-height:1.6;box-shadow:inset 0 0 30px rgba(229,72,77,.15)}
.lcd.ok{background:#061209;border-color:#1b4b26;color:#7ee29a;box-shadow:inset 0 0 30px rgba(63,185,80,.15)}
.lcd .big{font-size:18px;letter-spacing:2px}
.req{display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 0}
.req .st{width:16px;height:16px;border-radius:50%;border:2px solid #555}
.req.done .st{background:var(--green);border-color:var(--green)}

/* ---------- Terminal ---------- */
.term{width:min(1180px,96vw);height:min(760px,88vh);display:grid;grid-template-rows:42px 1fr 26px;background:#0b141c;border:1px solid #23394a;border-radius:12px;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.65),0 0 0 1px rgba(79,195,199,.08);font-family:var(--ui);color:#d9e6ee}
.term-top{display:flex;align-items:center;gap:12px;padding:0 14px;background:linear-gradient(180deg,#123045,#0e2433);border-bottom:1px solid #23394a;font-size:13px}
.term-top .logo{font-family:var(--serif);letter-spacing:3px;font-size:13px;color:#e8f2f7}
.term-top .sess{margin-left:auto;font-family:var(--mono);font-size:11.5px;color:#9cc0d1}
.term-top .warn{background:#5a3a07;color:#ffd08a;border:1px solid #8a5a10;border-radius:6px;padding:2px 8px;font-size:11px;font-family:var(--mono)}
.term-mid{display:grid;grid-template-columns:200px 1fr;min-height:0}
.term-side{background:#0d1922;border-right:1px solid #1d3344;padding:10px 8px;display:flex;flex-direction:column;gap:4px;overflow:auto}
.appbtn{display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:13px;color:#cfe0ea;border:1px solid transparent;background:transparent;text-align:left;width:100%}
.appbtn:hover{background:#132736}
.appbtn.on{background:#173247;border-color:#2a5470;color:#fff}
.appbtn .ico{width:24px;height:24px;border-radius:6px;display:grid;place-items:center;font-size:13px;background:#1b3446;flex:none}
.appbtn.locked{opacity:.5}
.appbtn .lk{margin-left:auto;font-size:11px}
.appbtn .dn{margin-left:auto;color:#62d17a;font-size:12px}
.term-main{overflow:auto;padding:18px 22px;min-height:0;scrollbar-width:thin;scrollbar-color:#2a4558 transparent}
.term-bot{display:flex;align-items:center;gap:16px;padding:0 12px;background:#0d1922;border-top:1px solid #1d3344;font-family:var(--mono);font-size:11px;color:#7fa1b3}
.term h3{margin:0 0 4px;font-weight:600;font-size:17px;color:#eef6fa}
.term .sub{color:#8fb0c2;font-size:12.5px;margin-bottom:14px;line-height:1.5}
.term table{border-collapse:collapse;width:100%;font-size:12px}
.term th{text-align:left;padding:6px 8px;background:#11222f;color:#9ec3d6;font-weight:600;font-size:11px;letter-spacing:.5px;text-transform:uppercase;border-bottom:1px solid #23394a;position:sticky;top:0;z-index:1}
.term td{padding:6px 8px;border-bottom:1px solid #16293a;vertical-align:top}
.term tr.hlrow td{background:#2a1517}
.term tr.flag td{background:#2b1f0b}
.term .num{font-family:var(--mono);text-align:right;white-space:nowrap}
.term .mono{font-family:var(--mono)}
.term .card{background:#0e1c27;border:1px solid #1f3a4d;border-radius:10px;padding:14px 16px}
.term .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.term .toggle{display:inline-flex;border:1px solid #2a4558;border-radius:8px;overflow:hidden}
.term .toggle button{border:0;background:#0f2130;color:#9ec3d6;padding:5px 10px;font-size:11.5px;cursor:pointer}
.term .toggle button.on.rel{background:#18412a;color:#bff0cb}
.term .toggle button.on.hold{background:#5a1a1d;color:#ffd2d3}
.term .scroll{max-height:330px;overflow:auto;border:1px solid #1d3344;border-radius:8px}
.login{max-width:560px;margin:10px auto;background:#0e1c27;border:1px solid #1f3a4d;border-radius:14px;padding:22px 26px}
.coord{display:flex;gap:10px;align-items:center;margin:6px 0}
.coord .cl{width:44px;height:36px;border-radius:8px;background:#173247;display:grid;place-items:center;font-family:var(--mono);font-weight:bold;color:#fff}
.chart{background:#0a141c;border:1px solid #1d3344;border-radius:10px;padding:8px}
.chart svg{display:block;width:100%;height:auto}
.chart .bar{cursor:pointer}
.chart .bar:hover{filter:brightness(1.3)}
.msg{background:#0e1c27;border:1px solid #1f3a4d;border-radius:12px;padding:16px 18px;line-height:1.6;font-size:13.5px}
.msg .from{font-size:12px;color:#8fb0c2;margin-bottom:8px;font-family:var(--mono)}
.qblock{background:#0e1c27;border:1px solid #1f3a4d;border-radius:10px;padding:12px 14px;margin-bottom:10px}
.qblock .q{font-size:13px;margin-bottom:8px;color:#e8f2f7}
.qblock .q b{color:#9de6e8;font-family:var(--mono);margin-right:6px}
.qblock.bad{border-color:#7a2a2e}
.opt{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12.5px;cursor:pointer;color:#cfe0ea}
.opt input{accent-color:#4fc3c7}

/* ---------- Dossier & hints ---------- */
.dossier{width:min(920px,94vw);background:linear-gradient(180deg,#141920,#0e1217);border:1px solid var(--line2);border-radius:14px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.55)}
.tabs{display:flex;border-bottom:1px solid var(--line2);background:#11151b}
.tab{padding:12px 18px;cursor:pointer;font-size:13px;color:var(--muted);border-bottom:2px solid transparent;letter-spacing:.4px}
.tab:hover{color:#fff}
.tab.on{color:#f2e6cc;border-bottom-color:var(--brass)}
.tabbody{padding:16px 20px;max-height:66vh;overflow:auto}
.finding{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.5}
.finding .fid{font-family:var(--mono);color:#ff9fa2;font-weight:bold}
.finding .fc{grid-column:2;font-size:11.5px;color:var(--muted)}
.evlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.evitem{padding:10px 12px;border-radius:10px;background:#161b22;border:1px solid var(--line2);cursor:pointer;font-size:13px;transition:border-color .12s}
.evitem:hover{border-color:var(--brass)}
.evitem small{display:block;color:var(--muted);font-size:11px;margin-top:3px}
.hintobj{padding:12px 0;border-bottom:1px solid var(--line)}
.hintobj .ht{font-size:14px;margin-bottom:8px;color:#f1e7d2}
.hintobj .hl{font-size:13px;line-height:1.55;color:#d8dde2;background:#151a21;border-left:3px solid var(--brass);padding:8px 12px;border-radius:6px;margin:6px 0}
.empty{color:var(--muted);font-size:13px;padding:10px 0}

/* ---------- Screens ---------- */
.screen{position:absolute;inset:0;z-index:50;display:flex;align-items:center;justify-content:center}
#screen-title{background:linear-gradient(90deg,rgba(3,4,6,.92) 0%,rgba(3,4,6,.65) 46%,rgba(3,4,6,.15) 100%)}
.title-wrap{position:absolute;left:7vw;top:50%;transform:translateY(-50%);max-width:560px}
.title-kicker{font-size:12px;letter-spacing:5px;text-transform:uppercase;color:var(--brass2);margin-bottom:16px}
.title-main{font-family:var(--serif);font-size:clamp(54px,8vw,104px);letter-spacing:.14em;line-height:.95;color:#f4ecdb;text-shadow:0 6px 40px rgba(0,0,0,.8);font-weight:normal}
.title-main span{display:block;font-size:.42em;letter-spacing:.42em;color:#c9b996;margin-top:14px}
.title-tag{font-family:var(--serif);font-style:italic;color:#bdb6a8;font-size:16px;margin:24px 0 30px;line-height:1.6;max-width:470px}
.menu{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.mbtn{min-width:280px;height:48px;padding:0 22px;border-radius:12px;border:1px solid var(--line2);background:rgba(16,20,26,.78);cursor:pointer;font-size:15px;letter-spacing:.6px;text-align:left;display:flex;align-items:center;gap:12px;transition:all .18s;color:#ece5d6;backdrop-filter:blur(6px)}
.mbtn:hover{border-color:var(--brass);transform:translateX(4px);background:rgba(30,36,44,.9)}
.mbtn.primary{background:linear-gradient(90deg,rgba(212,162,76,.9),rgba(160,118,44,.85));color:#1a1207;border-color:#f2c46d;font-weight:600}
.mbtn small{margin-left:auto;font-size:11.5px;opacity:.7}
.title-foot{position:absolute;left:7vw;bottom:28px;font-size:11.5px;color:#7d858c;letter-spacing:.4px;max-width:70vw;line-height:1.6}
.intro{max-width:760px;padding:40px;font-family:var(--serif);font-size:18px;line-height:1.85;color:#e7dfcf;text-shadow:0 2px 10px #000}
.intro .stampline{font-family:var(--mono);font-size:12px;letter-spacing:3px;color:var(--red2);margin-bottom:22px;text-transform:uppercase}
.intro p{margin:0 0 16px;opacity:0;transform:translateY(6px);transition:all .9s ease}
.intro p.on{opacity:1;transform:none}
.intro .go{margin-top:20px;opacity:0;transition:opacity .8s}
.intro .go.on{opacity:1}
#screen-intro{background:rgba(2,3,5,.9)}
#screen-loading{background:#040507;flex-direction:column;gap:18px;color:#a9a294;font-family:var(--serif);letter-spacing:4px;text-transform:uppercase;font-size:13px}
.loadbar{width:260px;height:2px;background:#1d2228;overflow:hidden;border-radius:2px}
.loadbar i{display:block;height:100%;width:40%;background:var(--brass);animation:loadb 1.3s ease-in-out infinite}
@keyframes loadb{0%{transform:translateX(-100%)}100%{transform:translateX(260%)}}
#screen-end{background:rgba(3,4,6,.94);overflow:auto;align-items:flex-start;padding:40px 0}
.endwrap{max-width:980px;margin:0 auto;padding:0 28px 60px}
.endhead{display:flex;gap:30px;align-items:center;margin-bottom:24px;flex-wrap:wrap}
.grade{width:170px;height:170px;border-radius:50%;border:2px solid var(--brass);display:grid;place-items:center;text-align:center;background:radial-gradient(circle,#2a2213,#0d0b07);box-shadow:0 0 50px rgba(212,162,76,.25)}
.grade b{display:block;font-family:var(--serif);font-size:20px;color:#f6e1b3;letter-spacing:1px}
.grade small{color:#b8a682;font-size:11px;letter-spacing:2px;text-transform:uppercase}
